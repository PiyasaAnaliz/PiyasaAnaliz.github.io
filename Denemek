import logging
from datetime import datetime
import pandas as pd
import yfinance as yf

# Loglama ayarları
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler("market_analysis.log"),
        logging.StreamHandler()
    ]
)

COMMODITIES = {
    "Altın": "GC=F",
    "Gümüş": "SI=F",
    "Bakır": "HG=F",
    "Ham Petrol": "CL=F"
}

EXCHANGES = {
    "Dolar/TL": "USDTRY=X",
    "Euro/TL": "EURTRY=X",
    "Euro/Dolar": "EURUSD=X"
}

WORLD_INDICES = {
    "Dow Jones": "^DJI",
    "S&P 500": "^GSPC",
    "NASDAQ": "^IXIC",
    "BIST 100": "XU100.IS"
}

def fetch_category_data(symbols_dict, value_label):
    results = []
    for name, ticker_symbol in symbols_dict.items():
        try:
            ticker = yf.Ticker(ticker_symbol)
            price = ticker.fast_info.get('last_price')
            if price:
                results.append({
                    "name": name,
                    "symbol": ticker_symbol,
                    value_label: round(price, 2),
                    "timestamp": datetime.now().strftime("%H:%M:%S")
                })
                logging.info(f"{name} verisi başarıyla çekildi.")
            else:
                logging.warning(f"{name} için fiyat verisi bulunamadı.")
        except Exception as e:
            logging.error(f"{name} çekilirken bir hata oluştu: {e}")
    return results

def main():
    logging.info("Piyasa Analiz Aracı başlatılıyor...")
    
    logging.info("Emtia verileri toplanıyor...")
    commodities_data = fetch_category_data(COMMODITIES, "price")
    
    logging.info("Döviz kuru verileri toplanıyor...")
    exchanges_data = fetch_category_data(EXCHANGES, "rate")
    
    logging.info("Borsa endeksleri toplanıyor...")
    indices_data = fetch_category_data(WORLD_INDICES, "value")

    print("\n" + "="*50)
    print(f"Piyasa Durumu - {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print("="*50)

    print("\n--- Değerli Madenler ve Emtialar ---")
    if commodities_data:
        print(pd.DataFrame(commodities_data).to_string(index=False))

    print("\n--- Döviz Kurları ---")
    if exchanges_data:
        print(pd.DataFrame(exchanges_data).to_string(index=False))

    print("\n--- Borsa Endeksleri ---")
    if indices_data:
        print(pd.DataFrame(indices_data).to_string(index=False))

    print("\n" + "="*50)

if __name__ == "__main__":
    main()

